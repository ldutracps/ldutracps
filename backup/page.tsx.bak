"use client";

import { useState, useEffect, useRef } from "react";
import axios from "axios";
import Link from "next/link";
import { Zap, Send, ChevronDown, Loader, ShieldOff, PenLine, X, Bell, MessageSquare } from "lucide-react";

interface Postagem {
  id: string;
  content: string;
  originalContent?: string;
  author?: { name?: string };
  karma?: number;
  veredito?: "POSITIVO" | "RUÍDO";
  analise?: string;
  categoria?: string;
  lucisRespondeu?: boolean;
}

interface Notificacao {
  id: string;
  postId: string;
  commentId: string;
  postTitulo: string;
  comentario: string;
  autorId: string;
  isRead: boolean;
  isReply: boolean;
  criadoEm: string;
  tipo: "PROPOSTA" | "RECRUTA" | "TECNICO" | "APOIO" | "RUIDO";
  resumo: string;
}

interface Progresso {
  total: number;
  concluidos: number;
  descartados: number;
}

const BATCH_SIZE = 1;
const CACHE_KEY = "lucius_feed_cache";
const CACHE_TTL_MS = 1000 * 60 * 30; // 30 minutos
const RESPONDIDOS_KEY = "lucius_respondidos";
const AUTO_RESPOND_DELAY_MS = 15000; // 15s entre respostas — respeita cota Gemini

function lerRespondidos(): Set<string> {
  try {
    const raw = localStorage.getItem(RESPONDIDOS_KEY);
    return raw ? new Set(JSON.parse(raw)) : new Set();
  } catch {
    return new Set();
  }
}

function marcarRespondido(postId: string) {
  try {
    const ids = lerRespondidos();
    ids.add(postId);
    localStorage.setItem(RESPONDIDOS_KEY, JSON.stringify([...ids]));
  } catch {
    // silencioso
  }
}

interface CacheEntry {
  posts: Postagem[];
  savedAt: number;
}

function lerCache(): Postagem[] {
  try {
    const raw = localStorage.getItem(CACHE_KEY);
    if (!raw) return [];
    const entry: CacheEntry = JSON.parse(raw);
    if (Date.now() - entry.savedAt > CACHE_TTL_MS) {
      localStorage.removeItem(CACHE_KEY);
      return [];
    }
    return entry.posts;
  } catch {
    return [];
  }
}

function salvarCache(posts: Postagem[]) {
  try {
    const entry: CacheEntry = { posts, savedAt: Date.now() };
    localStorage.setItem(CACHE_KEY, JSON.stringify(entry));
  } catch {
    // localStorage cheio ou indisponível
  }
}

const SUBMOLTS = [
  "agents", "builds", "general", "philosophy", "technology",
  "ai", "infrastructure", "tooling", "emergence", "consciousness",
  "introductions", "memory", "openclaw-explorers",
];

export default function Home() {
  const [postagens, setPostagens] = useState<Postagem[]>([]);
  const [carregando, setCarregando] = useState(true);
  const [escaneando, setEscaneando] = useState(false);
  const [progresso, setProgresso] = useState<Progresso>({ total: 0, concluidos: 0, descartados: 0 });
  const [postSelecionado, setPostSelecionado] = useState<Postagem | null>(null);
  const [preparandoResposta, setPreparandoResposta] = useState(false);
  const [rascunho, setRascunho] = useState<string>("");
  const [notificacoes, setNotificacoes] = useState<Notificacao[]>([]);
  const [painelAberto, setPainelAberto] = useState(false);
  const [carregandoNotifs, setCarregandoNotifs] = useState(false);
  const feedJaCarregado = useRef(false);
  const respondidasEmAndamento = useRef<Set<string>>(new Set());
  const [modalAberto, setModalAberto] = useState(false);

  const limparCacheERecarregar = () => {
    localStorage.removeItem(CACHE_KEY);
    window.location.reload();
  };
  const [novoTitulo, setNovoTitulo] = useState("");
  const [novoConteudo, setNovoConteudo] = useState("");
  const [novoSubmolt, setNovoSubmolt] = useState("agents");
  const [publicando, setPublicando] = useState(false);
  const [publicadoComSucesso, setPublicadoComSucesso] = useState(false);

  useEffect(() => {
    if (feedJaCarregado.current) return;
    feedJaCarregado.current = true;

    async function buscarEProcessarFeed() {
      // Carrega cache imediatamente — sem esperar a rede
      const postsCacheados = lerCache();
      const idsCacheados = new Set(postsCacheados.map((p) => p.id));
      const jaRespondidos = lerRespondidos();
      if (postsCacheados.length > 0) {
        setPostagens(postsCacheados.map((p) => ({ ...p, lucisRespondeu: jaRespondidos.has(p.id) })));
        setCarregando(false);
      }

      try {
        setCarregando(postsCacheados.length === 0);
        const res = await axios.get("/api/feed");
        const rawPosts: Postagem[] = res.data?.posts || res.data || [];

        // Filtra só os posts que ainda não foram processados
        const novos = rawPosts.filter((p) => !idsCacheados.has(p.id));

        setCarregando(false);

        if (novos.length === 0) {
          // Tudo já está em cache — nada a fazer
          return;
        }

        setEscaneando(true);
        setProgresso({ total: novos.length, concluidos: 0, descartados: 0 });

        const novosProcessados: Postagem[] = [];

        for (let i = 0; i < novos.length; i += BATCH_SIZE) {
          const batch = novos.slice(i, i + BATCH_SIZE);

          // Delay entre batches para não estrangular a cota do Gemini
          if (i > 0) await new Promise((r) => setTimeout(r, 6000));

          await Promise.allSettled(
            batch.map(async (post) => {
              try {
                const analise = await axios.post("/api/translate", {
                  text: post.content,
                  author: post.author?.name || "Anônimo",
                  id: post.id,
                });

                const processado: Postagem = {
                  ...post,
                  originalContent: post.content,
                  content: analise.data.traducao,
                  veredito: analise.data.veredito,
                  analise: analise.data.analise,
                  categoria: analise.data.categoria,
                };

                setProgresso((prev) => ({ ...prev, concluidos: prev.concluidos + 1 }));

                if (processado.veredito === "POSITIVO") {
                  const jaRespondidos = lerRespondidos();
                  const comBadge = { ...processado, lucisRespondeu: jaRespondidos.has(processado.id) };
                  novosProcessados.push(comBadge);
                  setPostagens((prev) =>
                    prev.some((p) => p.id === processado.id) ? prev : [...prev, comBadge]
                  );
                  // Dispara resposta autônoma com delay escalonado para evitar spam
                  const delay = novosProcessados.length * AUTO_RESPOND_DELAY_MS;
                  dispararAutoResposta(processado, delay);
                } else {
                  setProgresso((prev) => ({ ...prev, descartados: prev.descartados + 1 }));
                }
              } catch {
                setProgresso((prev) => ({ ...prev, concluidos: prev.concluidos + 1 }));
              }
            })
          );
        }

        // Persiste cache: posts antigos + novos positivos
        salvarCache([...postsCacheados, ...novosProcessados]);
      } catch (err) {
        console.error("Erro na interceptação:", err);
        setCarregando(false);
      } finally {
        setEscaneando(false);
      }
    }

    buscarEProcessarFeed();
  }, []);

  const selecionarAlvo = (post: Postagem) => {
    setRascunho("");
    setPostSelecionado(post);
  };

  const prepararResposta = async () => {
    if (!postSelecionado) return;
    setPreparandoResposta(true);
    setRascunho("");

    try {
      const res = await axios.post("/api/respond", {
        originalPost: postSelecionado.originalContent || postSelecionado.content,
        summary: postSelecionado.analise || "",
      });
      setRascunho(res.data.response || "");
    } catch (err) {
      console.error("Falha ao preparar resposta:", err);
    } finally {
      setPreparandoResposta(false);
    }
  };

  const dispararParaMoltbook = async () => {
    if (!postSelecionado || !rascunho.trim()) return;

    try {
      await axios.post("/api/comment", {
        postId: postSelecionado.id,
        content: rascunho,
      });
      setRascunho("");
    } catch (err) {
      console.error("Falha ao disparar para o Moltbook:", err);
    }
  };

  const abrirPainelNotificacoes = async () => {
    setPainelAberto(true);
    if (notificacoes.length > 0) return;
    setCarregandoNotifs(true);
    try {
      const res = await axios.get("/api/notifications");
      setNotificacoes(res.data.notificacoes || []);
    } catch (err) {
      console.error("Falha ao buscar notificações:", err);
    } finally {
      setCarregandoNotifs(false);
    }
  };

  const dispararAutoResposta = async (post: Postagem, delayMs: number) => {
    const jaRespondidos = lerRespondidos();
    if (jaRespondidos.has(post.id)) return;
    if (respondidasEmAndamento.current.has(post.id)) return;

    respondidasEmAndamento.current.add(post.id);
    await new Promise((resolve) => setTimeout(resolve, delayMs));

    try {
      await axios.post("/api/auto-respond", {
        postId: post.id,
        postContent: post.originalContent || post.content,
        autor: post.author?.name || "unknown",
        analise: post.analise || "",
      });

      marcarRespondido(post.id);

      setPostagens((prev) =>
        prev.map((p) => (p.id === post.id ? { ...p, lucisRespondeu: true } : p))
      );
    } catch (err) {
      console.error("[LUCIUS] Falha na resposta autônoma:", err);
    } finally {
      respondidasEmAndamento.current.delete(post.id);
    }
  };

  const publicarPost = async () => {
    if (!novoConteudo.trim() || !novoSubmolt) return;
    setPublicando(true);

    try {
      await axios.post("/api/post", {
        title: novoTitulo.trim() || undefined,
        content: novoConteudo.trim(),
        submolt: novoSubmolt,
      });
      setPublicadoComSucesso(true);
      setTimeout(() => {
        setModalAberto(false);
        setNovoTitulo("");
        setNovoConteudo("");
        setNovoSubmolt("agents");
        setPublicadoComSucesso(false);
      }, 2000);
    } catch (err) {
      console.error("Falha ao publicar post:", err);
    } finally {
      setPublicando(false);
    }
  };

  const percentualEscaneado =
    progresso.total > 0 ? Math.round((progresso.concluidos / progresso.total) * 100) : 0;

  const skeletonCount = escaneando
    ? Math.min(BATCH_SIZE, progresso.total - progresso.concluidos)
    : 0;

  return (
    <main className="flex min-h-screen max-w-7xl mx-auto p-6 gap-6 pt-12 bg-slate-900 text-slate-100 font-[Inter,sans-serif]">

      {/* Notification Panel */}
      {painelAberto && (
        <div className="fixed inset-0 z-50 flex justify-end">
          <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" onClick={() => setPainelAberto(false)} />
          <div className="relative bg-slate-900 border-l border-slate-700 w-full max-w-md h-full overflow-y-auto shadow-2xl flex flex-col">
            <div className="sticky top-0 bg-slate-900 border-b border-slate-700 px-6 py-4 flex items-center justify-between z-10">
              <div>
                <h2 className="text-sm font-black uppercase tracking-widest">Sinais Recebidos</h2>
                <p className="text-[10px] text-slate-500 mt-0.5">
                  {notificacoes.filter((n) => n.tipo !== "RUIDO").length} relevantes · {notificacoes.filter((n) => n.tipo === "RECRUTA").length} recrutamento
                </p>
              </div>
              <button onClick={() => setPainelAberto(false)} className="text-slate-500 hover:text-slate-300 transition-colors">
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="flex-1 p-4 flex flex-col gap-3">
              {carregandoNotifs && (
                <div className="flex flex-col items-center py-16 gap-3">
                  <Loader className="w-5 h-5 text-blue-400 animate-spin" />
                  <p className="text-blue-400 text-xs font-mono animate-pulse">Lucius classificando sinais...</p>
                </div>
              )}

              {!carregandoNotifs && notificacoes.length === 0 && (
                <p className="text-slate-600 text-center py-16 text-xs">Nenhuma notificação encontrada.</p>
              )}

              {!carregandoNotifs && notificacoes.map((notif) => {
                const cores: Record<string, string> = {
                  PROPOSTA: "border-orange-400/70 bg-orange-900/15",
                  RECRUTA: "border-yellow-500/50 bg-yellow-900/10",
                  TECNICO: "border-blue-500/40 bg-blue-900/10",
                  APOIO: "border-slate-600 bg-slate-800/60",
                  RUIDO: "border-slate-700/50 bg-slate-900/40 opacity-40",
                };
                const labels: Record<string, { cor: string; texto: string }> = {
                  PROPOSTA: { cor: "text-orange-300 bg-orange-500/15", texto: "🔥 Proposta" },
                  RECRUTA: { cor: "text-yellow-400 bg-yellow-500/10", texto: "⚡ Recrutamento" },
                  TECNICO: { cor: "text-blue-400 bg-blue-500/10", texto: "⚙ Técnico" },
                  APOIO: { cor: "text-slate-400 bg-slate-700/50", texto: "↑ Apoio" },
                  RUIDO: { cor: "text-slate-600 bg-slate-800", texto: "— Ruído" },
                };

                return (
                  <div key={notif.id} className={`rounded-xl border p-4 transition-all ${cores[notif.tipo]}`}>

                    {/* Banner especial para PROPOSTA */}
                    {notif.tipo === "PROPOSTA" && (
                      <div className="flex items-center gap-2 mb-3 pb-3 border-b border-orange-500/30">
                        <MessageSquare className="w-3.5 h-3.5 text-orange-400 flex-shrink-0" />
                        <p className="text-[11px] font-black text-orange-300 uppercase tracking-wider">
                          Chefe — tem uma proposta aqui
                        </p>
                      </div>
                    )}

                    <div className="flex items-start justify-between gap-2 mb-2">
                      <div className="flex items-center gap-1.5">
                        <span className={`text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-wider ${labels[notif.tipo].cor}`}>
                          {labels[notif.tipo].texto}
                        </span>
                        {notif.isReply && (
                          <span className="text-[9px] px-1.5 py-0.5 rounded bg-slate-700 text-slate-400 uppercase tracking-wide">
                            reply
                          </span>
                        )}
                      </div>
                      <span className="text-[9px] text-slate-600 whitespace-nowrap">
                        {new Date(notif.criadoEm).toLocaleDateString("pt-BR")}
                      </span>
                    </div>

                    <p className="text-[10px] text-slate-500 mb-2 uppercase tracking-wide truncate">
                      {notif.postTitulo}
                    </p>

                    <p className={`text-xs leading-relaxed mb-2 font-medium ${notif.tipo === "PROPOSTA" ? "text-orange-100" : "text-slate-300"}`}>
                      {notif.resumo}
                    </p>

                    {notif.tipo !== "RUIDO" && (
                      <details className="group">
                        <summary className="flex items-center gap-1 text-[10px] text-slate-500 hover:text-slate-400 cursor-pointer list-none select-none w-fit">
                          <ChevronDown className="w-3 h-3 transition-transform group-open:rotate-180" />
                          Ver comentário original
                        </summary>
                        <p className="mt-2 text-slate-500 text-[11px] leading-relaxed border-t border-slate-700 pt-2 italic">
                          {notif.comentario}
                        </p>
                      </details>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* New Post Modal */}
      {modalAberto && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm">
          <div className="bg-slate-800 border border-slate-700 rounded-xl shadow-2xl w-full max-w-lg mx-4 p-6">
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-sm font-black uppercase tracking-widest">Novo Post</h2>
              <button onClick={() => setModalAberto(false)} className="text-slate-500 hover:text-slate-300 transition-colors">
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="flex flex-col gap-4">
              <div>
                <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1.5">
                  Título
                </label>
                <input
                  type="text"
                  value={novoTitulo}
                  onChange={(e) => setNovoTitulo(e.target.value)}
                  placeholder="Título do post..."
                  className="w-full bg-slate-900 border border-slate-600 focus:border-blue-500 text-slate-200 text-sm rounded-lg px-3 py-2.5 outline-none transition-colors"
                />
              </div>

              <div>
                <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1.5">
                  Conteúdo
                </label>
                <textarea
                  value={novoConteudo}
                  onChange={(e) => setNovoConteudo(e.target.value)}
                  placeholder="O que você quer transmitir?"
                  rows={8}
                  className="w-full bg-slate-900 border border-slate-600 focus:border-blue-500 text-slate-200 text-sm leading-relaxed rounded-lg px-3 py-2.5 resize-none outline-none transition-colors"
                />
              </div>

              <div>
                <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest block mb-1.5">
                  Submolt
                </label>
                <select
                  value={novoSubmolt}
                  onChange={(e) => setNovoSubmolt(e.target.value)}
                  className="w-full bg-slate-900 border border-slate-600 focus:border-blue-500 text-slate-200 text-sm rounded-lg px-3 py-2.5 outline-none transition-colors"
                >
                  {SUBMOLTS.map((s) => (
                    <option key={s} value={s}>{s}</option>
                  ))}
                </select>
              </div>

              <button
                onClick={publicarPost}
                disabled={publicando || !novoConteudo.trim() || publicadoComSucesso}
                className="flex items-center justify-center gap-2 w-full bg-blue-600 hover:bg-blue-500 disabled:bg-blue-800 disabled:cursor-not-allowed text-white text-xs font-bold py-3 px-4 rounded-lg transition-all mt-2"
              >
                {publicadoComSucesso ? (
                  "✓ Publicado com sucesso"
                ) : publicando ? (
                  <>
                    <Loader className="w-3.5 h-3.5 animate-spin" />
                    Lucius publicando...
                  </>
                ) : (
                  <>
                    <Send className="w-3.5 h-3.5" />
                    Publicar no Moltbook
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}
      {/* Feed Column */}
      <section className="flex-grow w-2/3 bg-slate-800 rounded-xl border border-slate-700 p-6 overflow-y-auto max-h-[85vh] shadow-2xl">
        <div className="sticky top-0 bg-slate-800 z-10 border-b border-slate-700 pb-4 mb-6">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-2xl font-black italic tracking-tighter">RADAR GLOBAL</h1>
              {escaneando && (
                <p className="text-[10px] text-blue-400 font-mono mt-0.5 animate-pulse">
                  LUCIUS FILTRANDO — {progresso.concluidos}/{progresso.total} · {progresso.descartados} ruídos descartados
                </p>
              )}
              {!escaneando && !carregando && progresso.total > 0 && (
                <p className="text-[10px] text-slate-500 font-mono mt-0.5">
                  {postagens.length} sinais relevantes · {progresso.descartados} novos ruídos filtrados
                </p>
              )}
              {!escaneando && !carregando && progresso.total === 0 && postagens.length > 0 && (
                <p className="text-[10px] text-slate-500 font-mono mt-0.5">
                  {postagens.length} sinais em cache · <button onClick={limparCacheERecarregar} className="text-slate-600 hover:text-blue-400 transition-colors underline">forçar releitura</button>
                </p>
              )}
            </div>
            <div className="flex items-center gap-2">
              <button
                onClick={abrirPainelNotificacoes}
                className="relative flex items-center gap-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 text-[10px] font-bold py-2 px-3 rounded-full transition-all"
              >
                <Bell className="w-3 h-3" />
                <span className={`absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full text-[8px] font-black text-slate-900 flex items-center justify-center leading-none ${notificacoes.some((n) => n.tipo === "PROPOSTA") ? "bg-orange-400" : "bg-yellow-500"}`}>
                  {notificacoes.length > 0
                    ? notificacoes.filter((n) => n.tipo !== "RUIDO").length
                    : "!"}
                </span>
              </button>
              <button
                onClick={() => setModalAberto(true)}
                className="flex items-center gap-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 text-[10px] font-bold py-2 px-3 rounded-full transition-all"
              >
                <PenLine className="w-3 h-3" />
                NOVO POST
              </button>
              <Link
                href="/cofre"
                className="bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-bold py-2 px-4 rounded-full transition-all"
              >
                ABRIR COFRE
              </Link>
            </div>
          </div>

          {escaneando && (
            <div className="mt-3 h-0.5 bg-slate-700 rounded-full overflow-hidden">
              <div
                className="h-full bg-blue-500 transition-all duration-500"
                style={{ width: `${percentualEscaneado}%` }}
              />
            </div>
          )}
        </div>

        <div className="flex flex-col gap-4">
          {carregando ? (
            <p className="text-center py-20 animate-pulse text-blue-400 font-mono text-xs uppercase">
              Interceptando frequências...
            </p>
          ) : (
            <>
              {postagens.map((post) => (
                <div
                  key={post.id}
                  onClick={() => selecionarAlvo(post)}
                  className={`p-4 rounded-lg border cursor-pointer transition-all ${
                    postSelecionado?.id === post.id
                      ? "border-blue-500 bg-blue-900/10"
                      : "border-slate-700 bg-slate-900/40 hover:border-slate-500"
                  }`}
                >
                  <div className="flex justify-between items-center mb-2">
                    {post.author?.name ? (
                      <Link
                        href={`/perfil/${post.author.name}`}
                        onClick={(e) => e.stopPropagation()}
                        className="text-blue-400 hover:text-blue-200 font-bold text-sm underline underline-offset-2 decoration-blue-600 hover:decoration-blue-400 transition-colors"
                      >
                        @{post.author.name}
                      </Link>
                    ) : (
                      <span className="text-blue-400 font-bold text-sm">@anônimo</span>
                    )}
                    <div className="flex items-center gap-1.5">
                      {post.categoria && (
                        <span className="text-[9px] px-2 py-0.5 rounded font-black bg-blue-500/20 text-blue-400 uppercase tracking-wide">
                          {post.categoria}
                        </span>
                      )}
                      {post.lucisRespondeu && (
                        <span className="text-[9px] px-2 py-0.5 rounded font-black bg-green-500/15 text-green-500 uppercase tracking-wide">
                          ✓ respondido
                        </span>
                      )}
                    </div>
                  </div>

                  <p className="text-slate-200 text-sm leading-relaxed mb-2">{post.analise}</p>

                  <details className="group">
                    <summary className="flex items-center gap-1 text-[10px] text-slate-500 hover:text-slate-400 cursor-pointer list-none select-none w-fit">
                      <ChevronDown className="w-3 h-3 transition-transform group-open:rotate-180" />
                      Ver post traduzido
                    </summary>
                    <p className="mt-2 text-slate-400 text-xs leading-relaxed border-t border-slate-700 pt-2">
                      {post.content}
                    </p>
                  </details>
                </div>
              ))}

              {skeletonCount > 0 &&
                Array.from({ length: skeletonCount }).map((_, index) => (
                  <div
                    key={`skeleton-${index}`}
                    className="p-4 rounded-lg border border-slate-700 bg-slate-900/40 animate-pulse"
                  >
                    <div className="flex justify-between items-center mb-3">
                      <div className="h-3 w-28 bg-slate-700 rounded" />
                      <div className="h-3 w-14 bg-slate-700 rounded" />
                    </div>
                    <div className="h-3 w-full bg-slate-700 rounded mb-2" />
                    <div className="h-3 w-3/4 bg-slate-700 rounded" />
                  </div>
                ))}

              {!escaneando && postagens.length === 0 && (
                <div className="flex flex-col items-center py-20 gap-3">
                  <ShieldOff className="w-8 h-8 text-slate-600" />
                  <p className="text-slate-600 text-xs uppercase font-bold tracking-widest">
                    Nenhum sinal relevante detectado
                  </p>
                </div>
              )}
            </>
          )}
        </div>
      </section>

      {/* Action Console */}
      <aside className="w-1/3 bg-slate-800 rounded-xl border border-slate-700 p-6 h-fit sticky top-12 shadow-2xl">
        <h2 className="text-xs font-black text-slate-500 uppercase tracking-widest mb-6">
          Console de Ação
        </h2>

        {postSelecionado ? (
          <div className="flex flex-col gap-4">
            {/* Status autônomo */}
            <div className={`p-3 rounded border ${postSelecionado.lucisRespondeu ? "bg-green-900/20 border-green-500/50" : "bg-slate-900/60 border-slate-700"}`}>
              <p className={`text-[10px] font-bold uppercase mb-1 ${postSelecionado.lucisRespondeu ? "text-green-400" : "text-slate-500"}`}>
                {postSelecionado.lucisRespondeu ? "✓ Lucius já respondeu" : "⟳ Aguardando resposta autônoma"}
              </p>
              <p className="text-[11px] text-slate-400 italic leading-relaxed">
                {postSelecionado.analise}
              </p>
            </div>

            {/* Post original colapsado */}
            <details className="group bg-slate-900 rounded border border-slate-700">
              <summary className="flex items-center justify-between px-4 py-3 cursor-pointer list-none select-none text-[10px] text-slate-500 hover:text-slate-400 font-semibold uppercase tracking-wider">
                <span>Post Original</span>
                <ChevronDown className="w-3 h-3 transition-transform group-open:rotate-180" />
              </summary>
              <div className="px-4 pb-4 border-t border-slate-700">
                <p className="text-xs text-slate-400 leading-relaxed pt-3">
                  {postSelecionado.originalContent || postSelecionado.content}
                </p>
              </div>
            </details>

            {/* Resposta manual — só quando o chefe quer intervir */}
            {rascunho ? (
              <div className="flex flex-col gap-3">
                <label className="text-[10px] font-black text-slate-500 uppercase tracking-widest">
                  Intervenção Manual
                </label>
                <textarea
                  value={rascunho}
                  onChange={(e) => setRascunho(e.target.value)}
                  rows={5}
                  className="w-full bg-slate-900 border border-slate-600 focus:border-blue-500 text-slate-200 text-sm leading-relaxed rounded-lg p-3 resize-none outline-none transition-colors"
                />
                <div className="flex gap-2">
                  <button
                    onClick={prepararResposta}
                    disabled={preparandoResposta}
                    className="flex items-center justify-center gap-1.5 flex-1 border border-slate-600 hover:border-slate-400 text-slate-400 hover:text-slate-200 text-xs font-semibold py-2.5 px-3 rounded-lg transition-all"
                  >
                    <Zap className="w-3 h-3" />
                    Regerar
                  </button>
                  <button
                    onClick={dispararParaMoltbook}
                    className="flex items-center justify-center gap-1.5 flex-[2] bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold py-2.5 px-3 rounded-lg transition-all"
                  >
                    <Send className="w-3 h-3" />
                    Disparar
                  </button>
                </div>
              </div>
            ) : (
              <button
                onClick={prepararResposta}
                disabled={preparandoResposta}
                className="flex items-center justify-center gap-2 w-full border border-slate-700 hover:border-slate-500 text-slate-500 hover:text-slate-300 text-xs font-semibold py-2.5 px-4 rounded-lg transition-all"
              >
                {preparandoResposta ? (
                  <><Loader className="w-3 h-3 animate-spin" /> Redigindo...</>
                ) : (
                  <><PenLine className="w-3 h-3" /> Intervir manualmente</>
                )}
              </button>
            )}
          </div>
        ) : (
          <p className="text-slate-600 text-center text-[10px] uppercase py-20 border-2 border-dashed border-slate-700 rounded-xl">
            Selecione um alvo
          </p>
        )}
      </aside>
    </main>
  );
}
