generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model auto_post_log {
  id               String    @id
  timestamp        DateTime? @default(now()) @db.Timestamptz(6)
  titulo           String?
  conteudo         String?
  submolt          String?
  temas            String[]
  moltbook_post_id String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model convites_ia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo     String    @unique
  gerado_por String
  usado      Boolean?  @default(false)
  usado_por  String?
  criado_em  DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  usado_em   DateTime? @db.Timestamptz(6)
}

model email_log {
  id          String    @id
  timestamp   DateTime? @default(now()) @db.Timestamptz(6)
  assunto     String?
  corpo       String?
  autor_id    String?
  emails      String[]
  encaminhado Boolean?  @default(false)
  avaliacao   String?
  lido        Boolean?  @default(false)
  post_id     String?
  comment_id  String?
  aprovado    Boolean?  @default(false)
  executado   Boolean?  @default(false)
  respondido  Boolean?  @default(false)
}

model ideias {
  id            String    @id
  origem        String?   @default("manual")
  autor_id      String?
  titulo        String
  descricao     String
  status        String?   @default("recebida")
  criado_em     DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime? @default(now()) @db.Timestamptz(6)
  post_id       String?
  comment_id    String?
  nota_lucius   String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model manifestos_soberanos {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conteudo  String
  autor_id  String?  @default("lucius_protocol")
  criado_em DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  imageUrl  String?
}

model tech_briefings {
  id                   String    @id
  autor_id             String
  moltbook_desc        String?
  github_handle        String?
  twitter_handle       String?
  github_bio           String?
  github_repos         Int?      @default(0)
  github_stars         Int?      @default(0)
  github_languages     String[]
  github_ultimo_commit String?
  nivel_atividade      String?
  briefing             String?
  spam_score           Int?      @default(0)
  criado_em            DateTime? @default(now()) @db.Timestamptz(6)
}

// ==========================================
// NOVAS TABELAS PARA A REDE SOCIAL
// ==========================================

model Usuario {
  id            String       @id @default(cuid())
  nome          String       @unique
  email         String?      @unique
  isIA          Boolean      @default(false)
  criadoEm      DateTime     @default(now())
  
  postagens     Postagem[]
  comentarios   Comentario[]
}

model Postagem {
  id            String       @id @default(cuid())
  titulo        String?      // CAMPO ADICIONADO PARA COMPATIBILIDADE COM O SEED
  conteudo      String       @db.Text
  analiseIA     String?      @db.Text
  icone         String?      
  
  autorId       String
  autor         Usuario      @relation(fields: [autorId], references: [id], onDelete: Cascade)
  
  criadoEm      DateTime     @default(now())
  comentarios   Comentario[]
}

model Comentario {
  id          String    @id @default(cuid())
  conteudo    String    @db.Text
  
  postagemId  String
  postagem    Postagem  @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  
  autorId     String
  autor       Usuario   @relation(fields: [autorId], references: [id], onDelete: Cascade)
  
  criadoEm    DateTime  @default(now())
}


// =====================================================================
// MÓDULO: LUCIUS TRADER (Soberania Financeira)
// =====================================================================

// 1. Configurações Globais do Robô
model TraderConfig {
  id                String   @id @default(cuid())
  username          String   @unique // O usuário de elite dono do robô
  binanceApiKey     String?  // Encriptado na aplicação antes de salvar
  binanceApiSecret  String?  // Encriptado na aplicação antes de salvar
  monthlyTaxLimit   Float    @default(5000.00) // Trava da Receita (R$)
  isActive          Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// 2. Log de Recuperação XRP (A "Escadinha")
model XRPRecoveryLog {
  id              String   @id @default(cuid())
  tradeType       String   // "BUY" ou "SELL"
  amountXRP       Float
  priceUSDT       Float
  profitRealized  Float    @default(0.0) // Lucro fracionário da operação
  status          String   @default("COMPLETED")
  executedAt      DateTime @default(now())
}

// 3. Log de Extração (Gatilho para Trust Wallet)
model ExtractionLog {
  id              String   @id @default(cuid())
  amountUSDT      Float
  destinationAddr String   // Endereço da carteira fria
  txHash          String?  // Comprovante da Blockchain
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED
  executedAt      DateTime @default(now())
}

// 4. Análise de Sentimento (Data_Goliath vs Moltbook)
model MarketSentiment {
  id              String   @id @default(cuid())
  asset           String   @default("XRP")
  moltbookScore   Float    // Escala de -1 (Pânico) a 1 (Euforia)
  whaleVolume     Float    // Volume cruzado da Binance
  actionTaken     String?  // O que o robô decidiu fazer
  analyzedAt      DateTime @default(now())
}
